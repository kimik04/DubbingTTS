# API Keys (or set GEMINI_API_KEY environment variable)
gemini_api_key: "your-gemini-api-key-here"

# Models
models:
  transcribe: "gemini-3-flash-preview"
  tts: "gemini-3.1-flash-live-preview"

# Audio settings
audio:
  sample_rate: 24000
  max_speed: 1.5
  bg_volume: 1.0
  dub_volume: 0.7

# Transcription source:
#   "subtitle" = read hardcoded subtitles, timestamp from when subtitle appears on screen
#   "video"    = transcribe from audio+visual, timestamp from when speech is heard
#   "audio"    = transcribe from voice only (no video needed)
transcription:
  source: "subtitle"

# Available voices for Live API TTS (use ONLY these names)
voices:
  male:
    - Puck
    - Charon
    - Fenrir
    - Orus
    - Enceladus
    - Iapetus
    - Algenib
    - Rasalgethi
    - Alnilam
    - Schedar
    - Gacrux
    - Achird
    - Zubenelgenubi
    - Sadaltager
  female:
    - Aoede
    - Kore
    - Zephyr
    - Leda
    - Callirrhoe
    - Autonoe
    - Despina
    - Erinome
    - Laomedeia
    - Achernar
    - Pulcherrima
    - Vindemiatrix
    - Sadachbia
    - Sulafat

# Demucs
demucs:
  model: "htdemucs"
  two_stems: true
